{
    "configurations": [
        {
            "name": "RPi5 (Docker)",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/include",
                "/opt/rpi/include/opencv4",
                "/opt/rpi/include"
            ],
            "defines": [
                "__aarch64__",
                "__linux__"
            ],
            "compilerPath": "/usr/bin/aarch64-linux-gnu-g++",
            "configurationProvider": "ms-vscode.cmake-tools",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-arm64"
        }
    ],
    "version": 4
}
